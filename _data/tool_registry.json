[
  {
    "name": "batch_embedder",
    "description": "Encode a batch of texts into dense vectors.",
    "parameters": {
      "type": "object",
      "properties": {
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Texts to encode."
        },
        "model": {
          "type": "string",
          "description": "Embedding model identifier.",
          "default": "lab-dense-v3"
        },
        "normalize": {
          "type": "boolean",
          "description": "L2-normalise the output vectors.",
          "default": true
        }
      }
    }
  },
  {
    "name": "citation_resolver",
    "description": "Resolve a free-text citation to a structured bibliographic record.",
    "parameters": {
      "type": "object",
      "properties": {
        "raw_citation": {
          "type": "string",
          "description": "Citation text as it appears in the source document."
        },
        "style": {
          "type": "string",
          "description": "Target citation style.",
          "enum": [
            "APA",
            "MLA",
            "Chicago"
          ]
        },
        "include_abstract": {
          "type": "boolean",
          "description": "Attach the abstract when available.",
          "default": false
        }
      },
      "required": [],
      "optional": [
        "style",
        "include_abstract"
      ]
    }
  },
  {
    "name": "collection_stats",
    "description": "Aggregate document and token counts for a retrieval collection.",
    "parameters": {
      "type": "object",
      "properties": {
        "collection_id": {
          "type": "string",
          "description": "Identifier of the retrieval collection."
        },
        "window_days": {
          "type": "integer",
          "description": "Trailing window in days.",
          "default": 30
        },
        "include_deleted": {
          "type": "boolean",
          "description": "Count soft-deleted documents.",
          "optional": true
        },
        "group_by": {
          "type": "string",
          "description": "Aggregation bucket.",
          "enum": [
            "day",
            "week"
          ],
          "optional": true
        }
      },
      "required": [
        "collection_id"
      ]
    }
  },
  {
    "name": "lexicon_search",
    "description": "Search a lexical database for entries that match a surface form or lemma.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Surface form or lemma to look up."
        },
        "lexicon_id": {
          "type": "string",
          "description": "Identifier of the lexical database.",
          "default": "core-lex"
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum number of entries to return.",
          "default": 25
        },
        "include_archaic": {
          "type": "boolean",
          "description": "Include archaic entries.",
          "optional": true
        }
      },
      "required": [
        "query",
        "lexicon_id"
      ],
      "optional": [
        "include_archaic"
      ]
    }
  },
  {
    "name": "rerank_service",
    "description": "Reorder candidate passages with a cross-encoder.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "The user query."
        },
        "passages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Candidate passages to reorder."
        },
        "top_k": {
          "type": "integer",
          "description": "Number of passages to keep.",
          "default": 50
        },
        "model": {
          "type": "string",
          "description": "Cross-encoder model identifier.",
          "default": "lab-cross-v2"
        }
      },
      "required": [
        "passages",
        "query"
      ],
      "optional": [
        "top_k",
        "model"
      ]
    }
  }
]
